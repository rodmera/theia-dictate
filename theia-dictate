def notify(msg, icon="audio-input-microphone", expire=2000):
    """Notificación de escritorio estándar vía notify-send.

    Este es el esquema que funciona y se ve bien; no se usa el OSD de
    hyprctl (se ve horrible en pantalla).
    """
    subprocess.run(["notify-send", "-t", str(expire), "-i", icon, "TheIA Dictate", msg])


def simulate_paste():
    """Simula Ctrl+Shift+V via teclado virtual a nivel de kernel (funciona en terminales)."""
    if not EVDEV_AVAILABLE:
        notify("evdev no instalado. Ejecuta: pip install evdev", "dialog-error", 5000)
        return
    try:
        ui = UInput()
        time.sleep(1.2)

        ui.write(e.EV_KEY, e.KEY_LEFTCTRL, 1);  ui.syn(); time.sleep(0.05)
        ui.write(e.EV_KEY, e.KEY_LEFTSHIFT, 1); ui.syn(); time.sleep(0.05)
        ui.write(e.EV_KEY, e.KEY_V, 1);         ui.syn(); time.sleep(0.05)
        ui.write(e.EV_KEY, e.KEY_V, 0);         ui.syn(); time.sleep(0.05)
        ui.write(e.EV_KEY, e.KEY_LEFTSHIFT, 0); ui.syn()
        ui.write(e.EV_KEY, e.KEY_LEFTCTRL, 0);  ui.syn()

        time.sleep(0.1)
        ui.close()
    except Exception as ex:
        notify(f"Error simulando pegado: {ex}", "dialog-error", 5000)


def insert_text(text):
    """Inserta texto en el foco. Estándar de las apps de dictado consolidadas
    (Superwhisper, Wisp, Mac Whisper): copiar al portapapeles y pegar.

    NUNCA teclear carácter por carácter con wtype: en textos con puntuación o
    números se pierden caracteres (la transcripción queda completa pero lo que
    se escribe no). Paste universal Ctrl+Shift+V (funciona en terminales y apps
    GUI) vía wtype; fallback a pegado virtual UInput si wtype no está.
    """
    if not text:
        return
    if not _copy_to_clipboard(text):
        notify("Error al copiar al portapapeles", "dialog-error", 3000)
        return
    if shutil.which("wtype"):
        paste = subprocess.run(["wtype", "-M", "ctrl", "-M", "shift", "-k", "v"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if paste.returncode == 0:
            return
    simulate_paste()


def _find_project(arg, projects_dir):
    """Matching por tokens en vez de substring libre."""
    arg_tokens = [t for t in re.split(r'[\s\-_]+', arg.lower()) if len(t) >= 3]
    if not arg_tokens:
        return None
    for folder in sorted(os.listdir(projects_dir), key=len):
        full_path = os.path.join(projects_dir, folder)
        if not os.path.isdir(full_path):
            continue
        folder_tokens = re.split(r'[\s\-_]+', folder.lower())
        for at in arg_tokens:
            for ft in folder_tokens:
                if at == ft or (len(at) >= 4 and ft.startswith(at)):
                    return folder
    return None


def _read_preloader_result(timeout=30):
    """Espera el resultado del pre-loader (max timeout segundos). Retorna dict o None."""
    open(READY_FILE, 'w').close()

    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(RESULT_FILE):
            try:
                with open(RESULT_FILE, encoding='utf-8') as f:
                    result = json.load(f)
                os.remove(RESULT_FILE)
                return result
            except Exception:
                break
        time.sleep(0.05)

    try:
        os.remove(READY_FILE)
    except FileNotFoundError:
        pass
    return None


def _copy_to_clipboard(text):
    proc = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
    proc.communicate(text.encode("utf-8"))
    return proc.returncode == 0


def is_blank_transcription(text):
    """True si la transcripción es vacía o solo ruido (Handy: is_blank_transcription).

    Evita pegar/guardar basura cuando Whisper devolvió silencio o signos de
    puntuación sueltos.
    """
    if not text:
        return True
    stripped = text.strip()
    if not stripped:
        return True
    # Solo puntuación / caracteres no verbales -> tratar como vacío
    return all(ch in ".,;:!?¿¡-—()[]{}…\"'`~*#@&%" for ch in stripped)


def _post_process_llm(system_prompt, user_content, config):
    """Envía post-proceso/refinado al proveedor configurado (default Gemini).

    Configuración opcional en config.json:
      "llm_provider": {
         "provider": "gemini" | "openai",
         "openai_base_url": "https://api.openai.com/v1",   # o compatible
         "openai_api_key": "...",
         "openai_model": "gpt-4o-mini",
         "lang_detect": true                              # auto-detect de idioma
      }
    Devuelve el texto final o None en caso de fallo/abstención.
    """
    provider = (config.get("llm_provider") or {}).get("provider", "gemini")
    if provider == "openai":
        return _openai_post_process(system_prompt, user_content, config)
    # Default: Gemini via ecosistema
    try:
        from shared_config import call_gemini
        return call_gemini(
            f"{system_prompt}\n\n{user_content}",
            temperature=0.3, timeout=45,
        )
    except Exception:
        return None


def _openai_post_process(system_prompt, user_content, config):
    """Post-proceso vía API OpenAI-compatible (cliente HTTP puro, sin SDK)."""
    import urllib.request
    import urllib.error

    lp = config.get("llm_provider") or {}
    base = lp.get("openai_base_url", "https://api.openai.com/v1")
    api_key = lp.get("openai_api_key", "")
    model = lp.get("openai_model", "gpt-4o-mini")
    if not api_key:
        return None

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_content},
        ],
        "temperature": 0.3,
        "max_tokens": 2000,
    }
    req = urllib.request.Request(
        f"{base.rstrip('/')}/chat/completions",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {api_key}"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        return data["choices"][0]["message"]["content"].strip()
    except (urllib.error.URLError, KeyError, IndexError, json.JSONDecodeError):
        return None


def auto_detect_language(text):
    """Heurística liviana de detección de idioma (es/en/pt). Marca estimación.

    Si el proveedor usa detección nativa, se prefiere esa; esto es un fallback
    para el adjetivo del resultado.
    """
    accented = sum(1 for ch in text if ch in "áéíóúñüÁÉÍÓÚÑÜ¿¡")
    if accented >= 2:
        return "es"
    # Portugués: muy frecuente ã/õ/ç
    pt = sum(1 for ch in text if ch in "ãõçãÃÕÇ")
    if pt >= 2:
        return "pt"
    return "es"  # default conservador


def _wav_with_leading_silence(audio_path, silence_ms=250):
    """Devuelve bytes de un WAV con `silence_ms` de silencio al inicio.

    El audio grabado arranca abrupto (sílaba inicial en 0ms) y los modelos
    (Gemini y Chirp) a veces la tratan como ruido de inicio y omiten la
    primera palabra. Con silencio previo el onset de habla queda limpio.
    """
    import io as _io
    import wave as _wave
    with _wave.open(audio_path, "rb") as w:
        sr = w.getframerate()
        sampwidth = w.getsampwidth()
        ch = w.getnchannels()
        nframes = w.getnframes()
        frames = w.readframes(nframes)
    silence_frames = int(sr * silence_ms / 1000)
    silence = b"\x00" * (silence_frames * sampwidth * ch)
    buf = _io.BytesIO()
    with _wave.open(buf, "wb") as nw:
        nw.setnchannels(ch)
        nw.setsampwidth(sampwidth)
        nw.setframerate(sr)
        nw.setnframes(nframes + silence_frames)
        nw.writeframes(silence + frames)
    return buf.getvalue()


def _gemini_transcribe(audio_path, language="es", model="gemini-3.7-flash"):
    """Transcripción de audio con Gemini (stt_provider=gemini).

    Envía el WAV inline a la API de Gemini. Retorna dict con 'text' (misma
    forma que stt.transcribe) para que el flujo de stop_and_transcribe no cambie.
    """
    import base64
    import urllib.request
    import urllib.error
    import json as _json

    sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills'))
    try:
        from shared_config import GEMINI_API_KEY
    except Exception as key_err:
        return {"error": f"shared_config/GEMINI_API_KEY: {key_err}"}

    if not GEMINI_API_KEY:
        return {"error": "GEMINI_API_KEY no configurada en el entorno del daemon"}

    if not os.path.exists(audio_path):
        return {"error": f"Archivo no encontrado: {audio_path}"}

    audio_b64 = base64.b64encode(_wav_with_leading_silence(audio_path)).decode()

    url = (f"https://generativelanguage.googleapis.com/v1beta/models/{model}"
           f":generateContent?key={GEMINI_API_KEY}")
    payload = {
        "contents": [{
            "parts": [
                {"inline_data": {"mime_type": "audio/wav", "data": audio_b64}},
                {"text": f"Transcribe el audio de voz en {language}. Devuelve SOLO el texto "
                         f"transcrito literalmente, sin agregar puntuación ni correcciones."},
            ]
        }],
        "generationConfig": {"temperature": 0.0}
    }
    req = urllib.request.Request(url, data=_json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            data = _json.loads(resp.read().decode())
    except urllib.error.HTTPError as http_err:
        body = http_err.read().decode(errors="replace")
        return {"error": f"Gemini HTTP {http_err.code}: {body[:300]}"}
    except Exception as net_err:
        return {"error": f"Gemini red: {net_err}"}

    try:
        text = data["candidates"][0]["content"]["parts"][0]["text"].strip()
    except (KeyError, IndexError):
        return {"error": f"Gemini respuesta sin texto: {str(data)[:300]}"}

    if not text:
        return {"error": "Gemini no devolvió texto (¿audio silencioso?)"}
    return {"text": text, "provider": "gemini", "model": model}


TOKEN_CACHE_FILE = "/tmp/theia-dictate-chirp-token.json"


def _read_token_cache(source_id=None):
    """Lee el access token cacheado si aún es válido (>60s restantes)."""
    if not os.path.exists(TOKEN_CACHE_FILE):
        return None
    try:
        with open(TOKEN_CACHE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        token = data.get("access_token")
        expires_at = data.get("expires_at", 0)
        cache_source = data.get("source_id")
        if source_id and cache_source and cache_source != source_id:
            return None
        if token and (expires_at - time.time()) > 60:
            return token
    except Exception:
        pass
    return None


def _write_token_cache(token, expires_at, source_id="default"):
    """Guarda el access token en caché con permisos restrictivos (0600)."""
    try:
        data = {
            "access_token": token,
            "expires_at": expires_at,
            "source_id": source_id,
            "saved_at": time.time(),
        }
        fd = os.open(TOKEN_CACHE_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with open(fd, "w", encoding="utf-8") as f:
            json.dump(data, f)
    except Exception:
        pass


def _get_sa_access_token(sa_path):
    """Genera un access token a partir de una Service Account de GCP.

    Inmune a expiraciones de sesión de usuario de Google Workspace (invalid_rapt).
    Retorna (token, error, expires_at).
    """
    if not os.path.exists(sa_path):
        return None, f"Archivo Service Account no encontrado: {sa_path}", None
    try:
        from google.oauth2 import service_account
        from google.auth.transport.requests import Request
        creds = service_account.Credentials.from_service_account_file(
            sa_path,
            scopes=["https://www.googleapis.com/auth/cloud-platform"]
        )
        creds.refresh(Request())
        expiry = creds.expiry.timestamp() if creds.expiry else (time.time() + 3600)
        return creds.token, None, expiry
    except ImportError:
        pass
    except Exception as sa_err:
        return None, f"Error en Service Account: {sa_err}", None

    try:
        import time as _t
        import urllib.request as _ur
        import urllib.parse as _up
        import json as _j
        import jwt as _jwt

        with open(sa_path) as f:
            sa_data = _j.load(f)
        now_ts = int(_t.time())
        payload = {
            "iss": sa_data["client_email"],
            "sub": sa_data["client_email"],
            "aud": "https://oauth2.googleapis.com/token",
            "iat": now_ts,
            "exp": now_ts + 3600,
            "scope": "https://www.googleapis.com/auth/cloud-platform",
        }
        signed_jwt = _jwt.encode(payload, sa_data["private_key"], algorithm="RS256")
        token_data = _up.urlencode({
            "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
            "assertion": signed_jwt,
        }).encode()
        req = _ur.Request("https://oauth2.googleapis.com/token", data=token_data)
        with _ur.urlopen(req, timeout=20) as resp:
            resp_data = _j.loads(resp.read().decode())
            at = resp_data.get("access_token")
            exp_in = resp_data.get("expires_in", 3600)
            return at, None, time.time() + exp_in
    except Exception as e:
        return None, f"Fallo al autenticar con Service Account: {e}", None


def _find_service_account_key(config=None):
    """Busca una Service Account Key en las ubicaciones estándar."""
    candidates = []
    if config:
        sa_cfg = config.get("stt_chirp_sa_path")
        if sa_cfg:
            candidates.append(os.path.expanduser(sa_cfg))
    candidates.extend([
        os.path.expanduser("~/.config/openclaw-secrets/chirp-sa-key.json"),
        os.path.expanduser("~/.config/openclaw-secrets/theia-stt-sa.json"),
        os.path.expanduser("~/.config/gcloud/chirp-sa-key.json"),
    ])
    for path in candidates:
        if os.path.exists(path):
            return path
    return None


def _get_chirp_access_token(adc_path=None, sa_path=None, use_cache=True, config=None):
    """Obtiene un access token OAuth para Google Cloud STT / Chirp.

    Estrategia de resolución en capas:
      1. Caché local en disco (/tmp/theia-dictate-chirp-token.json) si aún es válido (>60s restantes).
      2. Service Account Key (sa_path o ~/.config/openclaw-secrets/chirp-sa-key.json) -> Inmune a invalid_rapt.
      3. User ADC OAuth (adc_path o ~/.config/gcloud/application_default_credentials_theia.json).
    """
    import urllib.request
    import urllib.error
    import urllib.parse
    import json as _json

    # 1. Caché en disco
    if use_cache:
        cached = _read_token_cache()
        if cached:
            debug_log("Chirp: usando token desde caché local válido")
            return cached, None

    # 2. Service Account (Prioridad máxima por estabilidad y no expiración)
    if sa_path is None and adc_path is None:
        sa_path = _find_service_account_key(config)
    if sa_path and os.path.exists(sa_path):
        at, sa_err, expiry = _get_sa_access_token(sa_path)
        if at:
            debug_log(f"Chirp: token obtenido via Service Account ({sa_path})")
            if use_cache and expiry:
                _write_token_cache(at, expiry, source_id=sa_path)
            return at, None
        debug_log(f"Chirp: fallo SA ({sa_err}), intentando fallback ADC")

    # 3. User ADC
    explicit_adc = adc_path is not None
    if adc_path is None:
        adc_path = os.path.expanduser("~/.config/gcloud/application_default_credentials_theia.json")
    if not os.path.exists(adc_path):
        if not explicit_adc:
            alt_adc = os.path.expanduser("~/.config/gcloud/application_default_credentials.json")
            if os.path.exists(alt_adc):
                adc_path = alt_adc
            else:
                return None, f"Falta ADC de theia: {adc_path}"
        else:
            return None, f"Falta ADC de theia: {adc_path}"

    try:
        with open(adc_path) as f:
            adc = _json.load(f)
    except Exception as adc_err:
        return None, f"ADC theia ilegible: {adc_err}"

    token_data = urllib.parse.urlencode({
        "client_id": adc.get("client_id", ""),
        "client_secret": adc.get("client_secret", ""),
        "refresh_token": adc.get("refresh_token", ""),
        "grant_type": "refresh_token",
    }).encode()
    try:
        req = urllib.request.Request("https://oauth2.googleapis.com/token", data=token_data)
        with urllib.request.urlopen(req, timeout=20) as resp:
            resp_data = _json.loads(resp.read().decode())
            at = resp_data.get("access_token", "")
            expires_in = resp_data.get("expires_in", 3600)
        if not at:
            return None, "Token theia vacío (¿revocado?)"
        if use_cache:
            _write_token_cache(at, time.time() + expires_in, source_id=adc_path)
        return at, None
    except urllib.error.HTTPError as http_err:
        body = http_err.read().decode(errors="replace")
        try:
            err_data = _json.loads(body)
            desc = err_data.get("error_description") or err_data.get("error") or body
            subtype = err_data.get("error_subtype")
            if subtype and subtype not in desc:
                desc = f"{desc} ({subtype})"
        except Exception:
            desc = body[:300]
        return None, f"Token theia HTTP {http_err.code}: {desc}"
    except Exception as tok_err:
        return None, f"Token theia: {tok_err}"


def _chirp_transcribe(audio_path, language="es-419", model="chirp_3", project_id="", region="us", adc_path=None, sa_path=None, config=None):
    """Transcripción con Google Cloud Speech-to-Text V2 (Chirp 3, stt_provider=chirp).

    Chirp 3 solo existe en la API V2 (endpoint regional + recognizer '_').
    Usa Service Account Key (si existe) o ADC de la cuenta theia,
    con quota project vía X-Goog-User-Project. Retorna dict con 'text' (misma
    forma que stt.transcribe) para no cambiar el flujo de stop_and_transcribe.
    """
    import base64
    import urllib.request
    import urllib.error
    import json as _json

    if not os.path.exists(audio_path):
        return {"error": f"Archivo no encontrado: {audio_path}"}

    at, tok_err = _get_chirp_access_token(adc_path=adc_path, sa_path=sa_path, config=config)
    if tok_err:
        return {"error": tok_err}
    if not at:
        return {"error": "Token theia no disponible"}

    audio_b64 = base64.b64encode(_wav_with_leading_silence(audio_path)).decode()

    recognizer = f"projects/{project_id}/locations/{region}/recognizers/_"
    payload = _json.dumps({
        "config": {
            "auto_decoding_config": {},
            "language_codes": [language],
            "model": model,
            "features": {"enable_automatic_punctuation": True},
        },
        "content": audio_b64,
    }).encode()
    url = (f"https://{region}-speech.googleapis.com/v2/{recognizer}:recognize")
    headers = {"Authorization": f"Bearer {at}", "Content-Type": "application/json",
               "X-Goog-User-Project": project_id}
    req = urllib.request.Request(url, data=payload, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            r = _json.loads(resp.read().decode())
    except urllib.error.HTTPError as http_err:
        body = http_err.read().decode(errors="replace")
        return {"error": f"Chirp HTTP {http_err.code}: {body[:300]}"}
    except Exception as net_err:
        return {"error": f"Chirp red: {net_err}"}

    results = r.get("results", [])
    if not results:
        return {"error": "Chirp no devolvió resultados (¿silencio?)"}
    text = " ".join(res.get("alternatives", [{}])[0].get("transcript", "")
                    for res in results).strip()
    if not text:
        return {"error": "Chirp transcript vacío"}
    return {"text": text, "provider": "chirp", "model": model}


def _local_transcribe(audio_path, language="es"):
    """Transcripción con Whisper local (faster-whisper)."""
    if not os.path.exists(audio_path):
        return {"error": f"Archivo no encontrado: {audio_path}"}
    res = _read_preloader_result()
    if res is not None and isinstance(res, dict) and not res.get("error"):
        if "provider" not in res:
            res["provider"] = "local"
        return res
    debug_log("preloader: sin resultado, uso fallback directo faster-whisper")
    try:
        sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills/stt/scripts'))
        from stt import transcribe
        res = transcribe(audio_path, model_size="turbo", language=language, beam_size=5)
        if isinstance(res, dict):
            if "provider" not in res:
                res["provider"] = "local"
            return res
        return {"text": str(res), "provider": "local", "model": "turbo"}
    except Exception as transcribe_err:
        debug_log(f"Whisper local falló: {transcribe_err}")
        return {"error": f"Whisper local: {transcribe_err}"}


def transcribe_audio(audio_path, language="es", config=None):
    """
    Transcribe audio usando el proveedor configurado con fallback automático en cascada.
    Cadena de resolución:
      - Proveedor principal (stt_provider)
      - Proveedores de fallback si el principal falla por credenciales, red o API
    """
    if config is None:
        config = load_config()

    primary_provider = config.get("stt_provider", "local")
    providers_order = [primary_provider]
    for alt in ["gemini", "local", "chirp"]:
        if alt not in providers_order:
            providers_order.append(alt)

    failed_attempts = []
    lang_for_chirp = "es-419" if language == "es" else language

    for idx, prov in enumerate(providers_order):
        debug_log(f"Intentando transcripción con '{prov}' (intento {idx+1}/{len(providers_order)})")
        res = None
        if prov == "gemini":
            res = _gemini_transcribe(
                audio_path,
                language=language,
                model=config.get("stt_gemini_model", "gemini-3.7-flash"),
            )
        elif prov == "chirp":
            res = _chirp_transcribe(
                audio_path,
                language=lang_for_chirp,
                model=config.get("stt_chirp_model", "chirp_3"),
                project_id=config.get("stt_chirp_project", ""),
                region=config.get("stt_chirp_region", "us"),
                sa_path=config.get("stt_chirp_sa_path"),
                config=config,
            )
        elif prov == "local":
            res = _local_transcribe(audio_path, language=language)

        if not isinstance(res, dict):
            res = {"error": f"Respuesta inesperada de {prov}"}

        text = res.get("text", "")
        err = res.get("error")

        if text and not err:
            if prov != primary_provider:
                res["fallback_from"] = primary_provider
                res["failed_attempts"] = failed_attempts
                debug_log(f"✅ Fallback exitoso con '{prov}' (falló {primary_provider})")
            return res
        else:
            failed_attempts.append({"provider": prov, "error": err or "Sin texto"})
            debug_log(f"⚠️ Proveedor '{prov}' falló: {err}")

    primary_err = failed_attempts[0]["error"] if failed_attempts else "Desconocido"
    return {
        "error": f"Todos los proveedores STT fallaron ({primary_provider}: {primary_err})",
        "failed_attempts": failed_attempts,
    }


