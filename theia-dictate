def notify(msg, icon="audio-input-microphone", expire=2000):
    """Notificación de escritorio estándar vía notify-send.

    Este es el esquema que funciona y se ve bien; no se usa el OSD de
    hyprctl (se ve horrible en pantalla).
    """
    subprocess.run(["notify-send", "-t", str(expire), "-i", icon, "TheIA Dictate", msg])


def simulate_paste():
    """Simula Ctrl+Shift+V via teclado virtual a nivel de kernel (funciona en terminales)."""
    if not EVDEV_AVAILABLE:
        notify("evdev no instalado. Ejecuta: pip install evdev", "dialog-error", 5000)
        return
    try:
        ui = UInput()
        time.sleep(1.2)

        ui.write(e.EV_KEY, e.KEY_LEFTCTRL, 1);  ui.syn(); time.sleep(0.05)
        ui.write(e.EV_KEY, e.KEY_LEFTSHIFT, 1); ui.syn(); time.sleep(0.05)
        ui.write(e.EV_KEY, e.KEY_V, 1);         ui.syn(); time.sleep(0.05)
        ui.write(e.EV_KEY, e.KEY_V, 0);         ui.syn(); time.sleep(0.05)
        ui.write(e.EV_KEY, e.KEY_LEFTSHIFT, 0); ui.syn()
        ui.write(e.EV_KEY, e.KEY_LEFTCTRL, 0);  ui.syn()

        time.sleep(0.1)
        ui.close()
    except Exception as ex:
        notify(f"Error simulando pegado: {ex}", "dialog-error", 5000)


def insert_text(text):
    """Inserta texto en el foco. Estándar de las apps de dictado consolidadas
    (Superwhisper, Wisp, Mac Whisper): copiar al portapapeles y pegar.

    NUNCA teclear carácter por carácter con wtype: en textos con puntuación o
    números se pierden caracteres (la transcripción queda completa pero lo que
    se escribe no). Paste universal Ctrl+Shift+V (funciona en terminales y apps
    GUI) vía wtype; fallback a pegado virtual UInput si wtype no está.
    """
    if not text:
        return
    if not _copy_to_clipboard(text):
        notify("Error al copiar al portapapeles", "dialog-error", 3000)
        return
    if shutil.which("wtype"):
        paste = subprocess.run(["wtype", "-M", "ctrl", "-M", "shift", "-k", "v"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if paste.returncode == 0:
            return
    simulate_paste()


def _find_project(arg, projects_dir):
    """Matching por tokens en vez de substring libre."""
    arg_tokens = [t for t in re.split(r'[\s\-_]+', arg.lower()) if len(t) >= 3]
    if not arg_tokens:
        return None
    for folder in sorted(os.listdir(projects_dir), key=len):
        full_path = os.path.join(projects_dir, folder)
        if not os.path.isdir(full_path):
            continue
        folder_tokens = re.split(r'[\s\-_]+', folder.lower())
        for at in arg_tokens:
            for ft in folder_tokens:
                if at == ft or (len(at) >= 4 and ft.startswith(at)):
                    return folder
    return None


def _read_preloader_result(timeout=30):
    """Espera el resultado del pre-loader (max timeout segundos). Retorna dict o None."""
    open(READY_FILE, 'w').close()

    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(RESULT_FILE):
            try:
                with open(RESULT_FILE, encoding='utf-8') as f:
                    result = json.load(f)
                os.remove(RESULT_FILE)
                return result
            except Exception:
                break
        time.sleep(0.05)

    try:
        os.remove(READY_FILE)
    except FileNotFoundError:
        pass
    return None


def _copy_to_clipboard(text):
    proc = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
    proc.communicate(text.encode("utf-8"))
    return proc.returncode == 0


def is_blank_transcription(text):
    """True si la transcripción es vacía o solo ruido (Handy: is_blank_transcription).

    Evita pegar/guardar basura cuando Whisper devolvió silencio o signos de
    puntuación sueltos.
    """
    if not text:
        return True
    stripped = text.strip()
    if not stripped:
        return True
    # Solo puntuación / caracteres no verbales -> tratar como vacío
    return all(ch in ".,;:!?¿¡-—()[]{}…\"'`~*#@&%" for ch in stripped)


def _post_process_llm(system_prompt, user_content, config):
    """Envía post-proceso/refinado al proveedor configurado (default Gemini).

    Configuración opcional en config.json:
      "llm_provider": {
         "provider": "gemini" | "openai",
         "openai_base_url": "https://api.openai.com/v1",   # o compatible
         "openai_api_key": "...",
         "openai_model": "gpt-4o-mini",
         "lang_detect": true                              # auto-detect de idioma
      }
    Devuelve el texto final o None en caso de fallo/abstención.
    """
    provider = (config.get("llm_provider") or {}).get("provider", "gemini")
    if provider == "openai":
        return _openai_post_process(system_prompt, user_content, config)
    # Default: Gemini via ecosistema
    try:
        from shared_config import call_gemini
        return call_gemini(
            f"{system_prompt}\n\n{user_content}",
            temperature=0.3, timeout=45,
        )
    except Exception:
        return None


def _openai_post_process(system_prompt, user_content, config):
    """Post-proceso vía API OpenAI-compatible (cliente HTTP puro, sin SDK)."""
    import urllib.request
    import urllib.error

    lp = config.get("llm_provider") or {}
    base = lp.get("openai_base_url", "https://api.openai.com/v1")
    api_key = lp.get("openai_api_key", "")
    model = lp.get("openai_model", "gpt-4o-mini")
    if not api_key:
        return None

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_content},
        ],
        "temperature": 0.3,
        "max_tokens": 2000,
    }
    req = urllib.request.Request(
        f"{base.rstrip('/')}/chat/completions",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {api_key}"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        return data["choices"][0]["message"]["content"].strip()
    except (urllib.error.URLError, KeyError, IndexError, json.JSONDecodeError):
        return None


def auto_detect_language(text):
    """Heurística liviana de detección de idioma (es/en/pt). Marca estimación.

    Si el proveedor usa detección nativa, se prefiere esa; esto es un fallback
    para el adjetivo del resultado.
    """
    accented = sum(1 for ch in text if ch in "áéíóúñüÁÉÍÓÚÑÜ¿¡")
    if accented >= 2:
        return "es"
    # Portugués: muy frecuente ã/õ/ç
    pt = sum(1 for ch in text if ch in "ãõçãÃÕÇ")
    if pt >= 2:
        return "pt"
    return "es"  # default conservador


def _wav_with_leading_silence(audio_path, silence_ms=250):
    """Devuelve bytes de un WAV con `silence_ms` de silencio al inicio.

    El audio grabado arranca abrupto (sílaba inicial en 0ms) y los modelos
    (Gemini y Chirp) a veces la tratan como ruido de inicio y omiten la
    primera palabra. Con silencio previo el onset de habla queda limpio.
    """
    import io as _io
    import wave as _wave
    with _wave.open(audio_path, "rb") as w:
        sr = w.getframerate()
        sampwidth = w.getsampwidth()
        ch = w.getnchannels()
        nframes = w.getnframes()
        frames = w.readframes(nframes)
    silence_frames = int(sr * silence_ms / 1000)
    silence = b"\x00" * (silence_frames * sampwidth * ch)
    buf = _io.BytesIO()
    with _wave.open(buf, "wb") as nw:
        nw.setnchannels(ch)
        nw.setsampwidth(sampwidth)
        nw.setframerate(sr)
        nw.setnframes(nframes + silence_frames)
        nw.writeframes(silence + frames)
    return buf.getvalue()


def _gemini_transcribe(audio_path, language="es", model="gemini-3.7-flash"):
    """Transcripción de audio con Gemini (stt_provider=gemini).

    Envía el WAV inline a la API de Gemini. Retorna dict con 'text' (misma
    forma que stt.transcribe) para que el flujo de stop_and_transcribe no cambie.
    """
    import base64
    import urllib.request
    import urllib.error
    import json as _json

    sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills'))
    try:
        from shared_config import GEMINI_API_KEY
    except Exception as key_err:
        return {"error": f"shared_config/GEMINI_API_KEY: {key_err}"}

    if not GEMINI_API_KEY:
        return {"error": "GEMINI_API_KEY no configurada en el entorno del daemon"}

    if not os.path.exists(audio_path):
        return {"error": f"Archivo no encontrado: {audio_path}"}

    audio_b64 = base64.b64encode(_wav_with_leading_silence(audio_path)).decode()

    url = (f"https://generativelanguage.googleapis.com/v1beta/models/{model}"
           f":generateContent?key={GEMINI_API_KEY}")
    payload = {
        "contents": [{
            "parts": [
                {"inline_data": {"mime_type": "audio/wav", "data": audio_b64}},
                {"text": f"Transcribe el audio de voz en {language}. Devuelve SOLO el texto "
                         f"transcrito literalmente, sin agregar puntuación ni correcciones."},
            ]
        }],
        "generationConfig": {"temperature": 0.0}
    }
    req = urllib.request.Request(url, data=_json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            data = _json.loads(resp.read().decode())
    except urllib.error.HTTPError as http_err:
        body = http_err.read().decode(errors="replace")
        return {"error": f"Gemini HTTP {http_err.code}: {body[:300]}"}
    except Exception as net_err:
        return {"error": f"Gemini red: {net_err}"}

    try:
        text = data["candidates"][0]["content"]["parts"][0]["text"].strip()
    except (KeyError, IndexError):
        return {"error": f"Gemini respuesta sin texto: {str(data)[:300]}"}

    if not text:
        return {"error": "Gemini no devolvió texto (¿audio silencioso?)"}
    return {"text": text, "provider": "gemini", "model": model}


def _chirp_transcribe(audio_path, language="es-419", model="chirp_3", project_id="", region="us"):
    """Transcripción con Google Cloud Speech-to-Text V2 (Chirp 3, stt_provider=chirp).

    Chirp 3 solo existe en la API V2 (endpoint regional + recognizer '_').
    Usa el ADC de la cuenta theia (application_default_credentials_theia.json),
    con quota project vía X-Goog-User-Project. Retorna dict con 'text' (misma
    forma que stt.transcribe) para no cambiar el flujo de stop_and_transcribe.
    """
    import base64
    import urllib.request
    import urllib.error
    import urllib.parse
    import json as _json

    adc_path = os.path.expanduser("~/.config/gcloud/application_default_credentials_theia.json")
    if not os.path.exists(adc_path):
        return {"error": f"Falta ADC de theia: {adc_path}"}
    try:
        adc = _json.load(open(adc_path))
    except Exception as adc_err:
        return {"error": f"ADC theia ilegible: {adc_err}"}

    if not os.path.exists(audio_path):
        return {"error": f"Archivo no encontrado: {audio_path}"}

    token_data = urllib.parse.urlencode({
        "client_id": adc.get("client_id", ""),
        "client_secret": adc.get("client_secret", ""),
        "refresh_token": adc.get("refresh_token", ""),
        "grant_type": "refresh_token",
    }).encode()
    try:
        at = _json.loads(urllib.request.urlopen(
            urllib.request.Request("https://oauth2.googleapis.com/token", data=token_data),
            timeout=20).read()).get("access_token", "")
    except Exception as tok_err:
        return {"error": f"Token theia: {tok_err}"}
    if not at:
        return {"error": "Token theia vacío (¿revocado?)"}

    audio_b64 = base64.b64encode(_wav_with_leading_silence(audio_path)).decode()

    recognizer = f"projects/{project_id}/locations/{region}/recognizers/_"
    payload = _json.dumps({
        "config": {
            "auto_decoding_config": {},
            "language_codes": [language],
            "model": model,
            "features": {"enable_automatic_punctuation": True},
        },
        "content": audio_b64,
    }).encode()
    url = (f"https://{region}-speech.googleapis.com/v2/{recognizer}:recognize")
    headers = {"Authorization": f"Bearer {at}", "Content-Type": "application/json",
               "X-Goog-User-Project": project_id}
    req = urllib.request.Request(url, data=payload, headers=headers)
    try:
        r = _json.loads(urllib.request.urlopen(req, timeout=120).read())
    except urllib.error.HTTPError as http_err:
        body = http_err.read().decode(errors="replace")
        return {"error": f"Chirp HTTP {http_err.code}: {body[:300]}"}
    except Exception as net_err:
        return {"error": f"Chirp red: {net_err}"}

    results = r.get("results", [])
    if not results:
        return {"error": "Chirp no devolvió resultados (¿silencio?)"}
    text = " ".join(res.get("alternatives", [{}])[0].get("transcript", "")
                    for res in results).strip()
    if not text:
        return {"error": "Chirp transcript vacío"}
    return {"text": text, "provider": "chirp", "model": model}


def stop_and_transcribe():
    pid = None
    for pf in (RECORDER_PID, PID_FILE):
        try:
            with open(pf, "r") as f:
                pid = int(f.read().strip())
            os.remove(pf)
            break
        except Exception:
            continue

    set_state("transcribing")

    if pid:
        try:
            os.kill(pid, 0)
            os.kill(pid, signal.SIGINT)
        except ProcessLookupError:
            pass

    os.system("pkill -f 'preloader.py'")
    time.sleep(0.2)

    # Leer estado persistido al iniciar grabación
    mode_key = "default"
    language = "es"
    append_mode = os.path.exists(APPEND_FILE)
    try:
        with open(MODE_FILE) as f:
            mode_key = f.read().strip()
        os.remove(MODE_FILE)
    except FileNotFoundError:
        pass
    try:
        with open(LANG_FILE) as f:
            language = f.read().strip()
        os.remove(LANG_FILE)
    except FileNotFoundError:
        pass
    try:
        os.remove(APPEND_FILE)
    except FileNotFoundError:
        pass

    config = load_config()
    vocabulary = config.get("vocabulary", [])
    mode = config.get("modes", {}).get(mode_key, {})
    mode_name = mode.get("name", mode_key)
    mode_prompt = mode.get("prompt", "")

    notify("Procesando...", "view-refresh", 5000)

    sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills/stt/scripts'))
    sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills'))

    stt_provider = config.get("stt_provider", "local")

    try:
        # 1. Transcripción (proveedor seleccionable: local faster-whisper o Gemini)
        if stt_provider == "gemini":
            debug_log("stt_provider=gemini: transcripción vía Gemini")
            res = _gemini_transcribe(
                AUDIO_FILE,
                language=language,
                model=config.get("stt_gemini_model", "gemini-3.7-flash"),
            )
        elif stt_provider == "chirp":
            debug_log("stt_provider=chirp: transcripción vía Google Cloud STT")
            res = _chirp_transcribe(
                AUDIO_FILE,
                language="es-419" if language == "es" else language,
                model=config.get("stt_chirp_model", "chirp_3"),
                project_id=config.get("stt_chirp_project", ""),
                region=config.get("stt_chirp_region", "us"),
            )
        else:
            res = _read_preloader_result()
            if res is None:
                debug_log("preloader: sin resultado, uso fallback directo")
                try:
                    from stt import transcribe
                    res = transcribe(AUDIO_FILE, model_size="turbo", language=language, beam_size=5)
                except Exception as transcribe_err:
                    debug_log(f"transcribe falló: {transcribe_err}")
                    notify(f"Error en transcripcion: {transcribe_err}", "dialog-error", 4000)
                    return
        debug_log(f"res.transcribe: text={str(res.get('text',''))[:50]!r} error={res.get('error','')}")

        raw_text = res.get("text", "")
        if not raw_text or "error" in res:
            debug_log(f"error o silencio: {res.get('error', 'Audio vacio')}")
            notify(f"Error o silencio: {res.get('error', 'Audio vacio')}", "dialog-error", 3000)
            return

        # Filtro de transcripción en blanco (Handy): descartar ruido/puntuación suelta
        if is_blank_transcription(raw_text):
            debug_log(f"transcripción en blanco: {raw_text!r}")
            notify("No se detectó voz (audio en blanco)", "dialog-warning", 2500)
            return

        log_history(raw_text=raw_text, refined_text="", is_cmd=False, mode=mode_key)
        debug_log("historial: entrada raw escrita")

        # 2. Modo raw: bypass Gemini, pegar directamente
        if mode_key == "raw":
            final_text = raw_text
            if append_mode:
                existing = subprocess.run(['wl-paste'], capture_output=True, text=True).stdout.rstrip()
                if existing:
                    final_text = existing + " " + final_text
            insert_text(final_text)
            notify(f"Texto insertado [Raw]", "emblem-default", 2000)
            set_state("idle")
            return

        # 3. Análisis de intención con Gemini
        from shared_config import call_gemini_structured

        vocab_hint = (
            f" Vocabulario específico del usuario (respetar exactamente): {', '.join(vocabulary)}."
            if vocabulary else ""
        )
        mode_hint = f" {mode_prompt}" if mode_prompt else ""
        is_vault = mode_key == "vault"

        schema = {
            "type": "OBJECT",
            "properties": {
                "is_command": {
                    "type": "BOOLEAN",
                    "description": "El usuario da una orden al computador (ej. 'abre X', 'recuérdame Y', 'dile a Sherlock Z')?"
                },
                "command_type": {
                    "type": "STRING",
                    "description": "Si is_command=true, elige: 'open_project', 'open_vault', 'add_todo', 'ask_sherlock', 'search_vault'. Si no, vacío."
                },
                "command_args": {
                    "type": "STRING",
                    "description": "Argumento de la orden (nombre del proyecto, tarea, o mensaje para Sherlock)."
                },
                "refined_text": {
                    "type": "STRING",
                    "description": (
                        f"Si is_command=false, texto final. Corrige errores fonéticos de Whisper y nombres propios "
                        f"(Watson, Sherlock, Claude, TheIA, Entel, TheIA Dictate).{vocab_hint} "
                        f"Si el usuario enumera elementos, formatea como lista con saltos de línea reales.{mode_hint}"
                    )
                }
            },
            "required": ["is_command"]
        }

        if is_vault:
            schema["properties"]["note_title"] = {
                "type": "STRING",
                "description": "Título breve y descriptivo para la nota de Obsidian (máx 60 caracteres)."
            }

        prompt_llm = (
            f"Eres el cerebro de TheIA Dictate. Decide si el texto es un dictado pasivo o una orden activa.\n"
            f"Si el usuario pide a la máquina que haga algo (\"Abre el vault\", \"busca en mis notas X\", "
            f"\"recuérdame Y\", \"dile a Sherlock Z\"), marca is_command=true.\n"
            f"Si es texto para pegar o guardar, marca is_command=false.\n\n"
            f"Texto dictado (puede tener errores fonéticos de Whisper): \"{raw_text}\""
        )

        res_json = call_gemini_structured(prompt_llm, schema, model="gemini-3.7-flash",
                                          temperature=0.1, timeout=45)
        if not res_json:
            raise Exception("Falla en API Gemini")

        log_history(
            raw_text=raw_text,
            refined_text=res_json.get("refined_text", ""),
            is_cmd=res_json.get("is_command", False),
            mode=mode_key,
            cmd_type=res_json.get("command_type"),
            cmd_args=res_json.get("command_args")
        )

        # 4. Ejecución
        if res_json.get("is_command"):
            cmd = res_json.get("command_type")
            arg = res_json.get("command_args", "")

            if cmd == "open_vault":
                subprocess.Popen(["xdg-open", "obsidian://open"],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                notify("Abriendo Vault...", "emblem-default")

            elif cmd == "add_todo":
                sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills/todoist/scripts'))
                from todoist import add_task
                add_task(arg, due_string="today", project_name="Inbox")
                notify(f"Tarea anadida a Todoist:\n{arg}", "emblem-default", 4000)

            elif cmd == "search_vault":
                notify(f"Buscando en tus notas:\n{arg}", "emblem-default", 4000)
                sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills/obsidian-qa/scripts'))
                from vault_qa import ask_sources
                try:
                    ans = ask_sources(arg, sources=['vault', 'personal'], top_k=3)
                    answer_text = ans.get('answer', 'No encontre nada relevante.') if isinstance(ans, dict) else str(ans)
                except Exception as rag_err:
                    answer_text = f"Error en busqueda RAG: {rag_err}"
                try:
                    subprocess.Popen(['zenity', '--info',
                                      '--title', f'Resultados: {arg}',
                                      '--text', answer_text,
                                      '--width=600', '--height=400'])
                except FileNotFoundError:
                    tmp_ans = "/tmp/theia-dictate-vault-answer.txt"
                    with open(tmp_ans, "w") as fh:
                        fh.write(f"Busqueda: {arg}\n\n{answer_text}")
                    subprocess.Popen(["xdg-open", tmp_ans])

            elif cmd == "ask_sherlock":
                sherlock_to = config.get("sherlock_to", "")
                if not sherlock_to:
                    notify("sherlock_to no configurado en config.json", "dialog-error", 4000)
                else:
                    subprocess.Popen(
                        ["openclaw", "agent", "--to", sherlock_to, "--message", arg],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                    )
                    notify(f"Mensaje enviado a Sherlock:\n{arg}", "emblem-default", 4000)

            elif cmd == "open_project":
                projects_dir = os.path.expanduser("~/projects")
                folder = _find_project(arg, projects_dir)
                if folder:
                    subprocess.Popen(
                        ["xdg-open", os.path.join(projects_dir, folder)],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        start_new_session=True
                    )
                    notify(f"Proyecto abierto: {folder}", "emblem-default")
                else:
                    notify(f"Proyecto no encontrado: {arg}", "dialog-error")
            else:
                notify(f"Comando no reconocido: {cmd}", "dialog-warning")

        else:
            final_text = res_json.get("refined_text", raw_text)

            # Proveedor LLM configurable (función 5): si se configuró un proveedor
            # openai, refinar el texto aquí en vez de usar solo refined_text de Gemini.
            provider_cfg = config.get("llm_provider") or {}
            if provider_cfg.get("provider") and provider_cfg.get("provider") != "gemini":
                sys_prompt = (
                    "Eres el corrector de TheIA Dictate. Corrige errores fonéticos de "
                    "transcripción, respeta nombres propios y vocabulario del usuario."
                )
                vocab_hint = f" Vocabulario: {', '.join(config.get('vocabulary', []))}." \
                    if config.get("vocabulary") else ""
                lang_hint = ""
                if provider_cfg.get("lang_detect"):
                    lang = auto_detect_language(raw_text)
                    lang_hint = f" Idioma detectado: {lang}."
                override = _post_process_llm(
                    sys_prompt + vocab_hint + lang_hint,
                    raw_text,
                    config,
                )
                if override:
                    final_text = override

            # Post-proceso configurable (función 3): prompts editables seleccionables.
            pp_cfg = config.get("post_process") or {}
            if pp_cfg.get("enabled"):
                prompts = pp_cfg.get("prompts", [])
                sel_id = pp_cfg.get("selected_prompt")
                sel = next((p for p in prompts if p.get("id") == sel_id), None)
                if sel:
                    pp_result = _post_process_llm(
                        sel.get("prompt", ""),
                        final_text,
                        config,
                    )
                    if pp_result:
                        final_text = pp_result

            # Modo vault: guardar en Obsidian
            if is_vault:
                sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills/obsidian-capture/scripts'))
                try:
                    from capture import capture_note
                    ts = datetime.now().strftime("%Y%m%d%H%M")
                    title = res_json.get("note_title") or f"Nota de voz {ts}"
                    full_title = f"{ts} - {title}"
                    capture_note(full_title, final_text, tags=['unique', 'voice-note'])
                    notify(f"Nota guardada:\n{title}", "emblem-default", 3000)
                except Exception as vault_err:
                    notify(f"Error guardando en vault: {vault_err}", "dialog-error", 4000)
                return

            # Modo paste normal (con append opcional)
            if append_mode:
                existing = subprocess.run(['wl-paste'], capture_output=True, text=True).stdout.rstrip()
                if existing:
                    final_text = existing + " " + final_text

            insert_text(final_text)
            debug_log(f"insert_text ejecutado (len={len(final_text)})")
            notify(f"Texto insertado [{mode_name}]", "emblem-default", 2000)

    except Exception as err:
        notify(f"Falla del sistema: {err}", "dialog-error", 5000)
    finally:
        # Estado idle SIEMPRE al salir (también en early returns por error/silencio)
        set_state("idle")
        try:
            subprocess.run(["playerctl", "-a", "play"], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            pass


def start_recording(mode_override=None, append=False):
    config = load_config()
    mode_key = mode_override or config.get("default_mode", "default")
    language = config.get("language", "es")
    silence_timeout = config.get("silence_timeout")

    with open(MODE_FILE, 'w') as f:
        f.write(mode_key)
    with open(LANG_FILE, 'w') as f:
        f.write(language)
    if append:
        open(APPEND_FILE, 'w').close()

    for path in (RESULT_FILE, READY_FILE, MODEL_READY):
        try:
            os.remove(path)
        except FileNotFoundError:
            pass

    if silence_timeout:
        proc = subprocess.Popen(
            ["sox", "-t", "alsa", "default", "-r", "16000", "-c", "1", "-b", "16", AUDIO_FILE,
             "silence", "1", "0.1", "1%", "1", str(float(silence_timeout)), "1%"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        watcher_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "silence_watcher.py")
        subprocess.Popen(
            [sys.executable, watcher_path, str(proc.pid), os.path.realpath(__file__)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    elif config.get("auto_stop") == "vad":
        # VAD con suavizado (Silero/energía + onset/hangover/prefill) — función 1.
        # vad.py captura por frames y escribe el WAV al cortar por silencio.
        vad_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "vad.py")
        vad_args = [sys.executable, vad_path,
                    "--max-silence-ms", str(int(config.get("vad_max_silence_ms", 1500))),
                    "--onset-ms", str(int(config.get("vad_onset_ms", 120))),
                    "--hangover-ms", str(int(config.get("vad_hangover_ms", 500))),
                    "--prefill-ms", str(int(config.get("vad_prefill_ms", 240)))]
        if config.get("vad_use_silero"):
            vad_args.append("--use-silero")
        proc = subprocess.Popen(vad_args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        vad_watcher_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "vad_watcher.py")
        subprocess.Popen(
            [sys.executable, vad_watcher_path, os.path.realpath(__file__)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    else:
        proc = subprocess.Popen(
            ["arecord", "-D", "default", "-f", "S16_LE", "-c", "1", "-r", "16000", AUDIO_FILE],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )

    with open(RECORDER_PID, "w") as f:
        f.write(str(proc.pid))
    set_state("recording")

    # Pausar reproducción MPRIS durante la grabación (inspiración Voxtype).
    # Guard: playerctl puede no estar instalado — no debe tumbar el daemon.
    try:
        subprocess.run(["playerctl", "-a", "pause"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        pass

    preloader_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "preloader.py")
    if os.path.exists(preloader_path) and config.get("stt_provider", "local") != "gemini":
        subprocess.Popen([sys.executable, preloader_path],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    mode_name = config.get("modes", {}).get(mode_key, {}).get("name", mode_key)
    suffix = " [+append]" if append else ""
    auto_suffix = " [auto-stop]" if silence_timeout else ""
    notify(f"Escuchando... [{mode_name}]{suffix}{auto_suffix}", "media-record", 10000)


def run_daemon():
    """Daemon residente estilo Voxtype: SIGUSR1 = start, SIGUSR2 = stop&transcribir.

    Permite controlar el dictado desde el compositor (keybinds de Hyprland) sin
    evdev: `theia-dictate record start|stop|toggle|cancel`. Estado en STATE_FILE
    para integrar a la barra (status --follow --format json).
    """
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))
    set_state("idle")
    for f in (RECORDER_PID,):
        try:
            os.remove(f)
        except FileNotFoundError:
            pass

    def on_start(signum, frame):
        # Solo arrancar desde idle: evita reinicios fantasma por señales
        # encoladas (ej. silence_watcher) durante una transcripción en curso.
        if read_state() != "idle":
            return
        # Modo pedido por `record start --mode X` (keybind de vault, etc.)
        mode_req = None
        if os.path.exists(MODE_REQUEST):
            try:
                with open(MODE_REQUEST) as f:
                    mode_req = f.read().strip() or None
            except Exception:
                pass
            try:
                os.remove(MODE_REQUEST)
            except FileNotFoundError:
                pass
        start_recording(mode_override=mode_req)

    def on_stop(signum, frame):
        st = read_state()
        debug_log(f"on_stop: señal recibida, estado={st}")
        if st != "recording":
            return
        # Cancelar = descartar sin transcribir
        if os.path.exists(CANCEL_FILE):
            try:
                os.remove(CANCEL_FILE)
            except FileNotFoundError:
                pass
            for pf in (RECORDER_PID,):
                try:
                    with open(pf) as f:
                        rpid = int(f.read().strip())
                    os.kill(rpid, signal.SIGTERM)
                except Exception:
                    pass
                try:
                    os.remove(pf)
                except FileNotFoundError:
                    pass
            os.system("pkill -f 'preloader.py'")
            os.system("killall arecord 2>/dev/null; pkill -f 'sox.*alsa' 2>/dev/null")
            set_state("idle")
            return
        stop_and_transcribe()

    def on_term(signum, frame):
        try:
            os.remove(PID_FILE)
        except FileNotFoundError:
            pass
        sys.exit(0)

    signal.signal(signal.SIGUSR1, on_start)
    signal.signal(signal.SIGUSR2, on_stop)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    while True:
        time.sleep(10)


def record_cmd(cmd, mode=None):
    """Envía señales al daemon (start/stop/toggle/cancel). `mode` se pasa a
    `record start` para pedir un modo (ej. `--mode vault` desde el keybind)."""
    pid = daemon_pid()
    if not daemon_alive(pid):
        print("theia-dictate: daemon no está corriendo. Inicialo con: "
              "systemctl --user start theia-dictate")
        return 1

    if cmd == "cancel":
        # Descartar sin transcribir: señalizar cancelación al daemon (SIGUSR2).
        open(CANCEL_FILE, 'w').close()
        os.kill(pid, signal.SIGUSR2)
        return 0

    if cmd == "start" and mode:
        try:
            with open(MODE_REQUEST, 'w') as f:
                f.write(mode)
        except Exception:
            pass

    if cmd == "start":
        os.kill(pid, signal.SIGUSR1)
    elif cmd == "stop":
        os.kill(pid, signal.SIGUSR2)
    elif cmd == "toggle":
        os.kill(pid, signal.SIGUSR2 if read_state() == "recording" else signal.SIGUSR1)
    else:
        print("Uso: record <start|stop|toggle|cancel> [--mode <modo>]")
        return 1
    return 0


def status_cmd(follow=False, fmt="text"):
    """Muestra el estado del daemon; --follow emite un stream JSON (bar de Omarchy)."""
    import time as _time
    while True:
        state = read_state()
        pid = daemon_pid()
        alive = daemon_alive(pid)
        if fmt == "json":
            print(json.dumps({"state": state if alive else "stopped",
                              "pid": pid if alive else None}))
        else:
            if alive:
                print(state)
            else:
                print("stopped")
        if not follow:
            return 0
        sys.stdout.flush()
        _time.sleep(1)


if __name__ == "__main__":
    # Auto-bootstrap: si corre con el python del sistema y hay un .venv junto al
    # script, re-ejecutarse con el python del venv. Check por ruta (sin importar
    # faster_whisper, que pesa ~1s y ralentizaba cada invocación del CLI).
    here = os.path.dirname(os.path.realpath(__file__))
    venv_py = os.path.join(here, ".venv", "bin", "python3")
    if os.path.exists(venv_py) and os.path.realpath(sys.executable) != os.path.realpath(venv_py):
        os.execv(venv_py, [venv_py] + sys.argv)

    parser = argparse.ArgumentParser()
    parser.add_argument("--daemon", action="store_true",
                        help="Correr como daemon residente (recibe señales SIGUSR1/SIGUSR2)")
    sub = parser.add_subparsers(dest="command")

    p_record = sub.add_parser("record", help="Controlar la grabación del daemon")
    p_record.add_argument("action", choices=["start", "stop", "toggle", "cancel"])
    p_record.add_argument("--mode", default=None,
                          help="Modo de dictado para start (default, raw, email, chat, formal, notes, vault)")

    p_status = sub.add_parser("status", help="Estado del daemon (idle|recording|transcribing)")
    p_status.add_argument("--follow", action="store_true", help="Stream continuo (JSON)")
    p_status.add_argument("--format", choices=["text", "json"], default="text")

    parser.add_argument("--mode", default=None,
                        help="Modo de dictado: default, raw, email, chat, formal, notes, vault")
    parser.add_argument("--append", action="store_true",
                        help="Agregar el texto al portapapeles existente en vez de reemplazarlo")
    parser.add_argument("--history", nargs="?", const=10, type=int, metavar="N",
                        help="Mostrar las últimas N entradas del historial (default: 10)")
    parser.add_argument("--prompts", action="store_true",
                        help="Listar los prompts de post-proceso configurables")
    args = parser.parse_args()

    if args.command == "record":
        sys.exit(record_cmd(args.action, mode=args.mode))
    if args.command == "status":
        sys.exit(status_cmd(follow=args.follow, fmt=args.format))
    if args.daemon:
        run_daemon()
        sys.exit(0)
    if args.history is not None:
        show_history(args.history)
    elif args.prompts:
        show_post_process_prompts()
    elif daemon_alive():
        record_cmd("toggle")
    elif os.path.exists(RECORDER_PID):
        stop_and_transcribe()
    else:
        os.system("killall arecord 2>/dev/null; pkill -f 'sox.*alsa' 2>/dev/null")
        start_recording(mode_override=args.mode, append=args.append)
