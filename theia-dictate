  </div>
</body>
</html>"""
                self.wfile.write(html.encode("utf-8"))
            else:
                err = qs.get("error", ["desconocido"])[0]
                auth_code_holder["error"] = err
                self.send_response(400)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(f"Error de autenticación: {err}".encode("utf-8"))

    print("════════════════════════════════════════════════════════════")
    print(" THEIA DICTATE — REAUTENTICACIÓN GOOGLE OAUTH ONE-CLICK")
    print("════════════════════════════════════════════════════════════")
    print(f"• Servidor loopback escuchando en: {redirect_uri}")
    print(f"• Archivo destino: {adc_path}")
    print("")

    try:
        server = HTTPServer(("127.0.0.1", port), OAuthHandler)
    except Exception as bind_err:
        print(f"❌ Error al iniciar servidor local en puerto {port}: {bind_err}")
        return 1

    if not no_browser:
        print("🌐 Abriendo navegador para autorizar la cuenta Google...")
        try:
            webbrowser.open(auth_url)
        except Exception:
            pass
    print("\nSi el navegador no abrió automáticamente, abre este enlace:")
    print(f"\n{auth_url}\n")
    print("Esperando autorización en el navegador (presiona Ctrl+C para cancelar)...")

    try:
        while auth_code_holder["code"] is None and auth_code_holder["error"] is None:
            server.handle_request()
    except KeyboardInterrupt:
        print("\n⚠️ Autenticación cancelada por el usuario.")
        return 1
    finally:
        server.server_close()

    if auth_code_holder["error"]:
        print(f"\n❌ Error devuelto por Google: {auth_code_holder['error']}")
        return 1

    code = auth_code_holder["code"]
    print("\n🔑 Código recibido. Intercambiando por tokens permanentes...")

    token_data = urllib.parse.urlencode({
        "client_id": client_id,
        "client_secret": client_secret,
        "code": code,
        "grant_type": "authorization_code",
        "redirect_uri": redirect_uri,
    }).encode()

    try:
        req = urllib.request.Request("https://oauth2.googleapis.com/token", data=token_data)
        with urllib.request.urlopen(req, timeout=20) as resp:
            token_resp = _json.loads(resp.read().decode())
    except urllib.error.HTTPError as http_err:
        body = http_err.read().decode(errors="replace")
        print(f"❌ Error al canjear código (HTTP {http_err.code}): {body}")
        return 1
    except Exception as e:
        print(f"❌ Error de red: {e}")
        return 1

    refresh_token = token_resp.get("refresh_token")
    access_token = token_resp.get("access_token")
    expires_in = token_resp.get("expires_in", 3600)

    creds_to_save = {
        "type": "authorized_user",
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": refresh_token,
        "quota_project_id": quota_project,
    }

    os.makedirs(os.path.dirname(adc_path), exist_ok=True)
    fd = os.open(adc_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with open(fd, "w", encoding="utf-8") as f:
        _json.dump(creds_to_save, f, indent=2)

    if access_token:
        _write_token_cache(access_token, time.time() + expires_in, source_id=adc_path)

    print(f"✅ Credenciales guardadas exitosamente en: {adc_path}")
    print("✅ Caché de token actualizado.")
    print("\nVerificando conectividad con Chirp...")
    at, err = _get_chirp_access_token(adc_path=adc_path, use_cache=False)
    if at:
        print("🎉 ¡Google Cloud STT (Chirp 3) está 100% LISTO y OPERATIVO!")
    else:
        print(f"⚠️ Advertencia al verificar token: {err}")
    print("════════════════════════════════════════════════════════════")
    return 0


def audit_providers(config=None):
    """Auditoría y diagnóstico del estado de proveedores STT y credenciales."""
    if config is None:
        config = load_config()

    report = {
        "config_file": CONFIG_FILE,
        "config_exists": os.path.exists(CONFIG_FILE),
        "stt_provider": config.get("stt_provider", "local"),
        "language": config.get("language", "es"),
        "auto_stop": config.get("auto_stop", "silence"),
        "providers": {},
    }

    # 1. Chirp STT
    sa_path = _find_service_account_key(config)
    cached_token = _read_token_cache()
    adc_path = os.path.expanduser("~/.config/gcloud/application_default_credentials_theia.json")
    chirp_status = {
        "sa_path": sa_path,
        "sa_exists": bool(sa_path and os.path.exists(sa_path)),
        "cached_token_active": bool(cached_token),
        "adc_path": adc_path,
        "adc_exists": os.path.exists(adc_path),
        "project_id": config.get("stt_chirp_project", ""),
        "region": config.get("stt_chirp_region", "us"),
        "model": config.get("stt_chirp_model", "chirp_3"),
        "token_ok": False,
        "token_source": None,
        "error": None,
    }
    at, tok_err = _get_chirp_access_token(adc_path=adc_path, sa_path=sa_path, use_cache=True, config=config)
    if at:
        chirp_status["token_ok"] = True
        chirp_status["status"] = "OK"
        if sa_path and os.path.exists(sa_path):
            chirp_status["token_source"] = "service_account"
        elif cached_token:
            chirp_status["token_source"] = "cache"
        else:
            chirp_status["token_source"] = "adc"
    else:
        chirp_status["token_ok"] = False
        chirp_status["error"] = tok_err
        if tok_err and "invalid_rapt" in str(tok_err):
            chirp_status["reauth_required"] = True
            chirp_status["reauth_command"] = "theia-dictate auth"
    report["providers"]["chirp"] = chirp_status

    # 2. Gemini STT
    sys.path.insert(0, os.path.expanduser('~/.openclaw/workspace/skills'))
    gemini_key = None
    try:
        from shared_config import GEMINI_API_KEY
        gemini_key = GEMINI_API_KEY
    except Exception:
        gemini_key = os.getenv("GEMINI_API_KEY")

    report["providers"]["gemini"] = {
        "model": config.get("stt_gemini_model", "gemini-3.7-flash"),
        "has_api_key": bool(gemini_key),
        "status": "OK" if gemini_key else "FAIL (GEMINI_API_KEY no configurada)",
    }

    # 3. Local Whisper
    has_faster_whisper = False
    try:
        import faster_whisper
        has_faster_whisper = True
    except ImportError:
        pass

    report["providers"]["local"] = {
        "faster_whisper_installed": has_faster_whisper,
        "status": "OK" if has_faster_whisper else "WARN (faster_whisper no importable en este python)",
    }

    # 4. Sistema y Herramientas
    pid = daemon_pid()
    alive = daemon_alive(pid)
    tools = {}
    for tool in ["wtype", "wl-copy", "wl-paste", "notify-send", "arecord", "sox", "playerctl"]:
        tools[tool] = bool(os.system(f"which {tool} >/dev/null 2>&1") == 0)

    report["system"] = {
        "daemon_pid": pid,
        "daemon_alive": alive,
        "audio_file_exists": os.path.exists(AUDIO_FILE),
        "audio_file_size": os.path.getsize(AUDIO_FILE) if os.path.exists(AUDIO_FILE) else 0,
        "tools": tools,
    }

    return report


