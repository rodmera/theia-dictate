def start_recording(mode_override=None, append=False):
    config = load_config()
    mode_key = mode_override or config.get("default_mode", "default")
    language = config.get("language", "es")
    silence_timeout = config.get("silence_timeout")

    with open(MODE_FILE, 'w') as f:
        f.write(mode_key)
    with open(LANG_FILE, 'w') as f:
        f.write(language)
    if append:
        open(APPEND_FILE, 'w').close()

    for path in (RESULT_FILE, READY_FILE, MODEL_READY):
        try:
            os.remove(path)
        except FileNotFoundError:
            pass

    if silence_timeout:
        proc = subprocess.Popen(
            ["sox", "-t", "alsa", "default", "-r", "16000", "-c", "1", "-b", "16", AUDIO_FILE,
             "silence", "1", "0.1", "1%", "1", str(float(silence_timeout)), "1%"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        watcher_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "silence_watcher.py")
        subprocess.Popen(
            [sys.executable, watcher_path, str(proc.pid), os.path.realpath(__file__)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    elif config.get("auto_stop") == "vad":
        # VAD con suavizado (Silero/energía + onset/hangover/prefill) — función 1.
        # vad.py captura por frames y escribe el WAV al cortar por silencio.
        vad_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "vad.py")
        vad_args = [sys.executable, vad_path,
                    "--max-silence-ms", str(int(config.get("vad_max_silence_ms", 1500))),
                    "--onset-ms", str(int(config.get("vad_onset_ms", 120))),
                    "--hangover-ms", str(int(config.get("vad_hangover_ms", 500))),
                    "--prefill-ms", str(int(config.get("vad_prefill_ms", 240)))]
        if config.get("vad_use_silero"):
            vad_args.append("--use-silero")
        proc = subprocess.Popen(vad_args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        vad_watcher_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "vad_watcher.py")
        subprocess.Popen(
            [sys.executable, vad_watcher_path, os.path.realpath(__file__)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    else:
        proc = subprocess.Popen(
            ["arecord", "-D", "default", "-f", "S16_LE", "-c", "1", "-r", "16000", AUDIO_FILE],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )

    with open(RECORDER_PID, "w") as f:
        f.write(str(proc.pid))
    set_state("recording")

    # Pausar reproducción MPRIS durante la grabación (inspiración Voxtype).
    # Guard: playerctl puede no estar instalado — no debe tumbar el daemon.
    try:
        subprocess.run(["playerctl", "-a", "pause"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        pass

    preloader_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "preloader.py")
    if os.path.exists(preloader_path) and config.get("stt_provider", "local") != "gemini":
        subprocess.Popen([sys.executable, preloader_path],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    mode_name = config.get("modes", {}).get(mode_key, {}).get("name", mode_key)
    suffix = " [+append]" if append else ""
    auto_suffix = " [auto-stop]" if silence_timeout else ""
    notify(f"Escuchando... [{mode_name}]{suffix}{auto_suffix}", "media-record", 10000)


def run_daemon():
    """Daemon residente estilo Voxtype: SIGUSR1 = start, SIGUSR2 = stop&transcribir.

    Permite controlar el dictado desde el compositor (keybinds de Hyprland) sin
    evdev: `theia-dictate record start|stop|toggle|cancel`. Estado en STATE_FILE
    para integrar a la barra (status --follow --format json).
    """
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))
    set_state("idle")
    for f in (RECORDER_PID,):
        try:
            os.remove(f)
        except FileNotFoundError:
            pass

    def on_start(signum, frame):
        # Solo arrancar desde idle: evita reinicios fantasma por señales
        # encoladas (ej. silence_watcher) durante una transcripción en curso.
        if read_state() != "idle":
            return
        # Modo pedido por `record start --mode X` (keybind de vault, etc.)
        mode_req = None
        if os.path.exists(MODE_REQUEST):
            try:
                with open(MODE_REQUEST) as f:
                    mode_req = f.read().strip() or None
            except Exception:
                pass
            try:
                os.remove(MODE_REQUEST)
            except FileNotFoundError:
                pass
        start_recording(mode_override=mode_req)

    def on_stop(signum, frame):
        st = read_state()
        debug_log(f"on_stop: señal recibida, estado={st}")
        if st != "recording":
            return
        # Cancelar = descartar sin transcribir
        if os.path.exists(CANCEL_FILE):
            try:
                os.remove(CANCEL_FILE)
            except FileNotFoundError:
                pass
            for pf in (RECORDER_PID,):
                try:
                    with open(pf) as f:
                        rpid = int(f.read().strip())
                    os.kill(rpid, signal.SIGTERM)
                except Exception:
                    pass
                try:
                    os.remove(pf)
                except FileNotFoundError:
                    pass
            os.system("pkill -f 'preloader.py'")
            os.system("killall arecord 2>/dev/null; pkill -f 'sox.*alsa' 2>/dev/null")
            set_state("idle")
            return
        stop_and_transcribe()

    def on_term(signum, frame):
        try:
            os.remove(PID_FILE)
        except FileNotFoundError:
            pass
        sys.exit(0)

    signal.signal(signal.SIGUSR1, on_start)
    signal.signal(signal.SIGUSR2, on_stop)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    while True:
        time.sleep(10)


def record_cmd(cmd, mode=None):
    """Envía señales al daemon (start/stop/toggle/cancel). `mode` se pasa a
    `record start` para pedir un modo (ej. `--mode vault` desde el keybind)."""
    pid = daemon_pid()
    if not daemon_alive(pid):
        print("theia-dictate: daemon no está corriendo. Inicialo con: "
              "systemctl --user start theia-dictate")
        return 1

    if cmd == "cancel":
        # Descartar sin transcribir: señalizar cancelación al daemon (SIGUSR2).
        open(CANCEL_FILE, 'w').close()
        os.kill(pid, signal.SIGUSR2)
        return 0

    if cmd == "start" and mode:
        try:
            with open(MODE_REQUEST, 'w') as f:
                f.write(mode)
        except Exception:
            pass

    if cmd == "start":
        os.kill(pid, signal.SIGUSR1)
    elif cmd == "stop":
        os.kill(pid, signal.SIGUSR2)
    elif cmd == "toggle":
        os.kill(pid, signal.SIGUSR2 if read_state() == "recording" else signal.SIGUSR1)
    else:
        print("Uso: record <start|stop|toggle|cancel> [--mode <modo>]")
        return 1
    return 0


def status_cmd(follow=False, fmt="text"):
    """Muestra el estado del daemon; --follow emite un stream JSON (bar de Omarchy)."""
    import time as _time
    while True:
        state = read_state()
        pid = daemon_pid()
        alive = daemon_alive(pid)
        if fmt == "json":
            print(json.dumps({"state": state if alive else "stopped",
                              "pid": pid if alive else None}))
        else:
            if alive:
                print(state)
            else:
                print("stopped")
        if not follow:
            return 0
        sys.stdout.flush()
        _time.sleep(1)


