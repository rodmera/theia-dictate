def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, encoding='utf-8') as f:
                cfg = json.load(f)
            for key, val in DEFAULT_CONFIG.items():
                if key not in cfg:
                    cfg[key] = val
            return cfg
        except Exception:
            pass
    try:
        with open(CONFIG_FILE, 'w', encoding='utf-8') as f:
            json.dump(DEFAULT_CONFIG, f, ensure_ascii=False, indent=2)
    except Exception:
        pass
    return DEFAULT_CONFIG.copy()


def set_state(state):
    """Persiste el estado del daemon (idle|recording|transcribing) para status/bar."""
    try:
        with open(STATE_FILE, 'w') as f:
            f.write(state)
    except Exception:
        pass


def read_state():
    try:
        with open(STATE_FILE) as f:
            return f.read().strip() or "idle"
    except Exception:
        return "idle"


def daemon_pid():
    try:
        with open(PID_FILE) as f:
            return int(f.read().strip())
    except Exception:
        return None


def daemon_alive(pid=None):
    pid = pid if pid is not None else daemon_pid()
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


